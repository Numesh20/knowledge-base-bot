# ─────────────────────────────────────────────
#  KnowledgeBase Bot — Environment Variables Template
# ─────────────────────────────────────────────

# Get a free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Required for protected write endpoints (uploads, deletes, chat if you enable auth)
APP_API_KEY=change-me-to-a-long-random-secret

# Port (Optional, defaults to 8000 locally; set automatically by cloud hosts)
PORT=8000
